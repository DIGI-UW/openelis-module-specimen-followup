{
  "name": "openelis-module-specimen-followup-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pages of the Specimen Follow-up & Action Tracker module, built as a Module Federation remote of the OpenELIS shell",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json}\" vite.config.ts",
    "check-format": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json}\" vite.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@carbon/icons-react": "^11.77.1",
    "@carbon/react": "^1.104.1",
    "@module-federation/vite": "^1.23.8",
    "@openelis/module-sdk": "file:../core/frontend/packages/module-sdk",
    "@tanstack/react-query": "^4.44.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^12.1.5",
    "@types/react": "^17.0.89",
    "@types/react-dom": "^17.0.26",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-intl": "^5.25.1",
    "react-router-dom": "^5.3.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  }
}
