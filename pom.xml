<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.openelisglobal.module</groupId>
    <artifactId>openelis-module-specimen-followup</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>OpenELIS module: Specimen Follow-up &amp; Action Tracker</name>
    <description>
        An OpenELIS Global module (docs/modules.md in the core repository): follow-up actions on existing
        patients' specimens, with its own table, services, REST API, permissions, navigation and pages.
    </description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- The core this module is built and tested against; the manifest's requires.openelis is its lower bound -->
        <openelis.version>3.4.0-SNAPSHOT</openelis.version>
        <openelis.module-api.version>1.0.0-SNAPSHOT</openelis.module-api.version>
        <openelis.spi.version>1.0.0-SNAPSHOT</openelis.spi.version>
        <module.id>specimen-followup</module.id>
        <!-- -DskipFrontend builds the backend only (unit test runs) -->
        <skipFrontend>false</skipFrontend>
        <node.version>v20.20.0</node.version>
        <npm.version>10.8.2</npm.version>
    </properties>

    <dependencies>
        <!-- The three core contracts, provided by the application at runtime, never packaged -->
        <dependency>
            <groupId>org.openelisglobal</groupId>
            <artifactId>openelis-module-api</artifactId>
            <version>${openelis.module-api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.openelisglobal</groupId>
            <artifactId>openelis-spi</artifactId>
            <version>${openelis.spi.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- openelis-core: the application's classes (PatientService, SampleService, ...) with the
                 application's libraries (Spring, Hibernate, Jackson, ...) transitively, all provided -->
            <groupId>org.openelisglobal</groupId>
            <artifactId>openelisglobal</artifactId>
            <version>${openelis.version}</version>
            <classifier>classes</classifier>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.openelisglobal</groupId>
            <artifactId>openelis-module-test</artifactId>
            <version>${openelis.module-api.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.14.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <version>6.2.19</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.jayway.jsonpath</groupId>
            <artifactId>json-path</artifactId>
            <version>2.9.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${module.id}-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <release>21</release>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <!-- The prebuilt frontend ships inside the JAR under META-INF/resources/modules/<id>/ -->
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>1.15.1</version>
                <configuration>
                    <workingDirectory>frontend</workingDirectory>
                    <installDirectory>target</installDirectory>
                    <skip>${skipFrontend}</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>install node and npm</id>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <nodeVersion>${node.version}</nodeVersion>
                            <npmVersion>${npm.version}</npmVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm ci</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>ci --no-audit --no-fund</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm test</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>test</phase>
                        <configuration>
                            <arguments>test</arguments>
                            <environmentVariables>
                                <CI>true</CI>
                            </environmentVariables>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm run build</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Module-only libraries (compile scope that the core does not provide) go to lib/; this module has none -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>bundle module libraries</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                            <excludeScope>provided</excludeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
            </plugin>
        </plugins>
    </build>
</project>
